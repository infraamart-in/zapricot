# Copy to .env.local for local dev and fill in values there (never commit it).
# In production set them in Vercel → Project → Settings → Environment Variables.

# Public (bundled into the browser at build time, safe to expose):
VITE_TURNSTILE_SITE_KEY=

# Server-only (never prefix these with VITE_):
TURNSTILE_SECRET_KEY=
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
SITE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local only: 1 = the dev/preview server never forwards to Jotform (default 1)
JOTFORM_DRY_RUN=
